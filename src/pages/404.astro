---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
import { BRAND } from "@/content/barnes-content";
---

<Base title={`Page not found | ${BRAND}`} description="This page does not exist.">
  <section class="nf wrap">
    <p class="label">404</p>
    <h1 class="display display-l">This address <span class="tail">is not in our collection.</span></h1>
    <span class="rule"></span>
    <div class="nf__ctas">
      <Button href="/">Back to the home page</Button>
      <Button href="/destinations/" variant="outline">See the destinations</Button>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 5rem;
    justify-items: start;
    min-height: 80svh;
    align-content: center;
    padding-top: var(--header-h);
  }

  .nf h1 {
    max-width: 18ch;
  }

  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }
</style>
