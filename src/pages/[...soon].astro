---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
import { BRAND, comingSoon } from "@/content/barnes-content";

/** One minimal page per destination that is not built yet (registry in barnes-content.ts). */
export function getStaticPaths() {
  return Object.entries(comingSoon).map(([path, page]) => ({
    params: { soon: path.replace(/^\/|\/$/g, "") },
    props: { page },
  }));
}

interface Props {
  page: { title: string };
}

const { page } = Astro.props;
---

<Base title={`${page.title} — Coming soon | ${BRAND}`} description={`${page.title} is coming soon.`}>
  <section class="soon">
    <div class="soon__card" role="status">
      <p class="soon__label">Coming soon</p>
      <h1 class="soon__title">{page.title}</h1>
      <p class="soon__text">This page is being prepared. In the meantime, explore our current collection.</p>
      <div class="soon__actions">
        <Button href="/">Back to Home</Button>
        <Button href="/destinations/" variant="outline">Communities</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .soon {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-height: 100vh;
    padding: calc(var(--header-h) + 6rem) var(--gutter) 10rem;
    background: var(--paper);
  }

  .soon__card {
    width: 90rem;
    max-width: 100%;
    padding: 8rem;
    background: var(--white);
    text-align: center;
  }

  .soon__label {
    font-size: 1.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .soon__title {
    margin-top: 2rem;
    font-size: 6.4rem;
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--black);
  }

  .soon__text {
    margin-top: 2.4rem;
    font-size: 2.27rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .soon__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem;
    margin-top: 5rem;
  }

  @media (max-width: 767px) {
    .soon__card {
      padding: 4rem 2.4rem;
    }

    .soon__label {
      font-size: 1.1rem;
    }

    .soon__title {
      font-size: 3.2rem;
    }

    .soon__text {
      font-size: 1.5rem;
    }

    .soon__actions {
      margin-top: 3rem;
    }
  }
</style>
