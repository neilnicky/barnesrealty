---
import { Picture } from "astro:assets";
import type { ImageAsset } from "@/content/barnes-content";
import { resolveImage } from "@/lib/images";

interface Props {
  image: ImageAsset;
  /** Rendered width, e.g. "100vw" or "(max-width: 860px) 100vw, 33vw". */
  sizes: string;
  widths?: number[];
  priority?: boolean;
  decorative?: boolean;
  class?: string;
}

const { image, sizes, widths = [480, 800, 1200, 1600, 2000], priority = false, decorative = false, class: className } = Astro.props;
const meta = resolveImage(image.file);
const usable = widths.filter((w) => w <= meta.width);
if (usable.length === 0) usable.push(meta.width);
---

<Picture
  src={meta}
  alt={decorative ? "" : image.alt}
  formats={["avif"]}
  fallbackFormat="webp"
  widths={usable}
  sizes={sizes}
  quality={74}
  loading={priority ? "eager" : "lazy"}
  decoding={priority ? "sync" : "async"}
  fetchpriority={priority ? "high" : "auto"}
  class={className}
  style={image.focus ? `object-position:${image.focus}` : undefined}
  draggable="false"
/>
