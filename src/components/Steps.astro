---
import Button from "./Button.astro";
import TwoTone from "./TwoTone.astro";
import { home } from "@/content/barnes-content";

const { steps } = home;
---

<section class="stp section" aria-labelledby="stp-title">
  <div class="wrap stp__row">
    <div class="stp__left">
      <TwoTone text={steps.title} class="stp__title" id="stp-title" stack />
      <Button href={steps.cta.href}>{steps.cta.label}</Button>
    </div>
    <div class="stp__right">
      <p class="stp__label">{steps.label}</p>
      <ol class="stp__list">
        {steps.items.map((item, i) => (
          <li class="stp__item">
            <span class="stp__num">{String(i + 1).padStart(2, "0")}</span>
            <TwoTone text={item} as="p" class="stp__text" />
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .stp {
    position: relative;
    z-index: 2;
    background: var(--white);
  }

  .stp__row {
    display: flex;
    gap: 4rem;
  }

  .stp__left {
    width: 70.4rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4rem;
  }

  .stp__right {
    width: 97.6rem;
  }

  .stp__title {
    font-size: 7.2rem;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--black);
  }

  .stp__label {
    font-size: 3.2rem;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--black);
  }

  .stp__list {
    margin-top: 3rem;
  }

  .stp__item {
    display: flex;
    gap: 5rem;
    padding: 3rem 0;
    border-bottom: 1px solid rgb(21 23 23 / 0.07);
  }

  .stp__item:first-child {
    border-top: 1px solid rgb(21 23 23 / 0.07);
  }

  .stp__num {
    flex: none;
    width: 1.8rem;
    padding-top: 1.6rem;
    font-size: 1.4rem;
    color: var(--ink-muted);
  }

  .stp__text {
    font-size: 4.4rem;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--black);
  }

  @media (max-width: 767px) {
    .stp__row {
      flex-direction: column;
      gap: 4rem;
    }

    .stp__left,
    .stp__right {
      width: auto;
    }

    .stp__left {
      gap: 2.4rem;
    }

    .stp__title {
      font-size: 3.4rem;
    }

    .stp__label {
      font-size: 1.8rem;
    }

    .stp__item {
      gap: 2rem;
      padding: 2.2rem 0;
    }

    .stp__num {
      font-size: 1.1rem;
      padding-top: 0.6rem;
    }

    .stp__text {
      font-size: 2rem;
    }
  }
</style>
