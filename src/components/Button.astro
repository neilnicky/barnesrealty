---
/** FIND pill button: 44px tall, 13.5px/500 label, 18px arrow (measured at 1440). */
interface Props {
  href?: string;
  variant?: "ink" | "white" | "outline" | "ghost" | "stone";
  external?: boolean;
  class?: string;
  /** Render a <button> that opens the enquiry modal, optionally with a deal type. */
  modal?: string | true;
  block?: boolean;
  type?: "button" | "submit";
}

const { href, variant = "ink", external = false, class: className, modal, block = false, type = "button" } = Astro.props;
const v = variant === "stone" ? "white" : variant;
const ext = !!href && (external || /^https?:/.test(href));
const classes = ["btn", `btn--${v}`, { "btn--block": block }, className];
---

{href ? (
  <a class:list={classes} href={href} {...(ext ? { target: "_blank", rel: "noopener" } : {})}>
    <span class="btn__text"><slot /></span>
    <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3.315 10.996h16.623l-.884.707-8.084-8.135h2.526l8.261 8.337-8.286 8.337h-2.526l8.11-8.135.883.708H3.315z" /></svg>
    {ext && <span class="visually-hidden"> (opens barnes-international.com in a new tab)</span>}
  </a>
) : (
  <button class:list={classes} type={type} data-open-modal={modal === true ? "" : modal}>
    <span class="btn__text"><slot /></span>
    <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3.315 10.996h16.623l-.884.707-8.084-8.135h2.526l8.261 8.337-8.286 8.337h-2.526l8.11-8.135.883.708H3.315z" /></svg>
  </button>
)}

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    min-height: 44px;
    height: 5.87rem;
    padding: 1.54rem 3rem;
    border: 1px solid transparent;
    border-radius: 100px;
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .btn__icon {
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    transition: transform 0.3s;
  }

  .btn:hover .btn__icon,
  .btn:focus-visible .btn__icon {
    transform: translateX(0.5rem);
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn--ink {
    background: var(--ink);
    color: var(--white);
  }

  .btn--ink:hover {
    background: #2c2f2f;
  }

  .btn--white {
    background: var(--white);
    color: var(--ink);
  }

  .btn--white:hover {
    background: #e8e8e8;
  }

  .btn--outline {
    background: var(--white);
    color: var(--ink);
    border-color: rgb(21 23 23 / 0.3);
  }

  .btn--outline:hover {
    border-color: var(--ink);
  }

  .btn--ghost {
    color: var(--white);
    border-color: rgb(255 255 255 / 0.5);
  }

  .btn--ghost:hover {
    background: rgb(255 255 255 / 0.1);
    border-color: var(--white);
  }

  @media (max-width: 767px) {
    .btn {
      height: auto;
      min-height: 44px;
      padding: 1.1rem 2.2rem;
      font-size: 1.44rem;
      gap: 1rem;
    }

    .btn__icon {
      width: 1.8rem;
      height: 1.8rem;
    }
  }
</style>
