---
import Img from "./Img.astro";
import Button from "./Button.astro";
import TwoTone from "./TwoTone.astro";
import { home } from "@/content/barnes-content";

const { news } = home;
---

<section class="nws section tone-paper" aria-labelledby="nws-title">
  <div class="wrap">
    <div class="nws__grid">
      <TwoTone text={news.title} class="nws__title" id="nws-title" stack />
      <div>
        <p class="nws__text">{news.text}</p>
        <div class="nws__actions"><Button href={news.cta.href}>{news.cta.label}</Button></div>
      </div>
    </div>
    <ul class="nws__items">
      {news.items.map((post) => (
        <li class="nws__item">
          <article class="nws__entry">
            <a class="nws__thumb" href={post.href} tabindex="-1" aria-hidden="true">
              <Img image={post.image} sizes="(max-width: 767px) 100vw, 51vw" widths={[600, 1000, 1200]} decorative />
            </a>
            <div class="nws__col">
              <time class="nws__date" datetime={post.date}>{post.date}</time>
              <div>
                <h3 class="nws__post-title"><a href={post.href}>{post.title}</a></h3>
                <p class="nws__excerpt">{post.text}</p>
              </div>
              <div><Button href={post.href} variant="outline">Read More</Button></div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .nws {
    position: relative;
    z-index: 2;
  }

  .nws__grid {
    display: grid;
    grid-template-columns: 70.4rem 97.6rem;
    column-gap: 4rem;
  }

  .nws__title {
    font-size: 8rem;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--black);
  }

  .nws__text {
    font-size: 3.2rem;
    line-height: 1.3;
    font-weight: 500;
    color: var(--black);
  }

  .nws__actions {
    margin-top: 4rem;
  }

  .nws__items {
    margin-top: 10rem;
    border-bottom: 1px solid rgb(21 23 23 / 0.1);
  }

  .nws__item {
    padding: 3rem 0;
    border-top: 1px solid rgb(21 23 23 / 0.1);
  }

  .nws__entry {
    display: grid;
    grid-template-columns: 71.4rem 97.6rem;
    column-gap: 3rem;
    justify-content: space-between;
  }

  .nws__thumb {
    grid-column: 2;
    grid-row: 1;
    height: 45rem;
    overflow: hidden;
  }

  .nws__thumb :global(picture),
  .nws__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .nws__entry:hover .nws__thumb :global(img) {
    transform: scale(1.04);
  }

  .nws__col {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
  }

  .nws__date {
    font-size: 2rem;
    line-height: 1.5;
    font-weight: 500;
    color: var(--black);
  }

  .nws__post-title {
    font-size: 4.4rem;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--black);
  }

  .nws__post-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .nws__excerpt {
    margin-top: 2.4rem;
    font-size: 1.6rem;
    line-height: 1.5;
    font-weight: 500;
    color: var(--black);
  }

  @media (max-width: 767px) {
    .nws__grid,
    .nws__entry {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }

    .nws__title {
      font-size: 3.6rem;
    }

    .nws__text {
      font-size: 1.7rem;
    }

    .nws__actions {
      margin-top: 2.4rem;
    }

    .nws__items {
      margin-top: 4rem;
    }

    .nws__item {
      padding: 2.4rem 0;
    }

    .nws__thumb {
      grid-column: 1;
      height: 22rem;
    }

    .nws__col {
      grid-row: 2;
    }

    .nws__post-title {
      font-size: 2.2rem;
    }

    .nws__excerpt {
      font-size: 1.3rem;
    }
  }
</style>
