---
import Img from "./Img.astro";
import TwoTone from "./TwoTone.astro";
import { home } from "@/content/barnes-content";

const { why } = home;
---

<section class="why section" aria-labelledby="why-label">
  <div class="wrap">
    <div class="why__grid">
      <h2 class="why__label" id="why-label">{why.label}</h2>
      <TwoTone text={why.statement} as="p" class="why__text" />
    </div>
  </div>
  <figure class="why__preview" data-inview>
    <div class="why__frame">
      <Img image={why.image} sizes="100vw" widths={[800, 1400, 2000]} />
    </div>
  </figure>
</section>

<style>
  .why {
    position: relative;
    z-index: 2;
    background: var(--white);
  }

  .why__grid {
    display: grid;
    grid-template-columns: 74.4rem 97.6rem;
  }

  .why__label {
    font-size: 2rem;
    line-height: 1.4;
    font-weight: 600;
    color: var(--black);
  }

  .why__text {
    font-size: 5.6rem;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--black);
  }

  .why__preview {
    margin-top: 10rem;
  }

  /* Opens from the container width to full bleed when it enters (clip 1s, settle 4s). */
  .why__frame {
    height: 97.6rem;
    overflow: hidden;
    clip-path: inset(0 var(--gutter));
    transition: clip-path 1s var(--ease-out);
  }

  .why__frame :global(picture),
  .why__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.js-motion) .why__frame :global(img) {
    transform: scale(1.12);
    transition: transform 4s var(--ease-settle);
  }

  .why__preview:global(.is-in) .why__frame {
    clip-path: inset(0 0);
  }

  :global(.js-motion) .why__preview:global(.is-in) .why__frame :global(img) {
    transform: none;
  }

  @media (max-width: 767px) {
    .why__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .why__label {
      font-size: 1.44rem;
    }

    .why__text {
      font-size: 2.6rem;
    }

    .why__preview {
      margin-top: 4rem;
    }

    .why__frame {
      height: 42rem;
    }
  }
</style>
