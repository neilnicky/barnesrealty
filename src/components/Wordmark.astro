---
/** The BARNES wordmark, inline so it inherits currentColor. Traced from the official raster (see docs). */
import raw from "../../public/brand/barnes-wordmark.svg?raw";

interface Props {
  class?: string;
  title?: string;
}

const { class: className, title = "BARNES" } = Astro.props;
const svg = raw
  .replace('fill="#000000"', 'fill="currentColor"')
  .replace('role="img" aria-label="BARNES"', `role="img" aria-label="${title}" focusable="false"`)
  .replace("<svg", `<svg class="${className ?? ""}"`);
---

<Fragment set:html={svg} />
