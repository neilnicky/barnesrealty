---
/** Brand wordmark (placeholder: swap public/brand/barnes-wordmark.svg), inline so it inherits currentColor. */
import { BRAND } from "@/content/barnes-content";
import raw from "../../public/brand/barnes-wordmark.svg?raw";

interface Props {
  class?: string;
  title?: string;
}

const { class: className, title = BRAND } = Astro.props;
const svg = raw
  .replace('fill="#000000"', 'fill="currentColor"')
  .replace(/role="img" aria-label="[^"]*"/, `role="img" aria-label="${title}" focusable="false"`)
  .replace("<svg", `<svg class="${className ?? ""}"`);
---

<Fragment set:html={svg} />
